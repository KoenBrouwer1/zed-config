// Zed settings
{
  "disable_ai": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "hover_popover_enabled": false,
  "drag_and_drop_selection": {
    "enabled": true,
  },
  "project_panel": {
    "dock": "right",
  },
  "terminal": {
    "button": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": true,
  },
  "ui_font_family": ".SystemUIFont",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 500.0,
    "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": "Material Icon Theme",
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "auto_indent_on_paste": true,
  "tab_size": 2,
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "theme": "Nstlgy Dark",
  "vim_mode": false,
  "tab_bar": {
    "show": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "file_types": {
    "JSON": ["lock"]
  }
}